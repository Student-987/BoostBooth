# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode for accessing the BoostBooth Admin Dashboard.
# If left empty, the first user to open Admin can claim an initial passcode.
ADMIN_PASSCODE=

# GAS_WEB_APP_URL: Deployed Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
GAS_WEB_APP_URL=

# GAS_API_SECRET: Shared secret token matching Config.gs in your Google Apps Script project.
GAS_API_SECRET=
